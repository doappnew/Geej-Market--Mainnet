# --- Base de données (Supabase: chaîne "Connection pooling" / ou toute URL PostgreSQL) ---
DATABASE_URL=postgres://postgres@localhost:5433/geej
DATABASE_SSL=false            # true pour Supabase / Render Postgres

# --- Sécurité ---
JWT_SECRET=changez-moi-par-une-longue-valeur-aleatoire
NODE_ENV=development
PORT=3000
CORS_ORIGIN=                  # laisser vide si le front est servi par ce serveur

# --- Stockage des photos ---
# Par défaut: dossier local server/uploads (éphémère sur Render gratuit).
# Production: Supabase Storage (bucket public "product-images")
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images

# --- Pi Network (laisser vide tant que l'app n'est pas enregistrée) ---
PI_API_KEY=
PI_VALIDATION_KEY=            # contenu de /validation-key.txt fourni par le Developer Portal

# --- Compte administrateur initial (db:seed) ---
ADMIN_EMAIL=admin@geejmarket.sn
ADMIN_PASSWORD=
